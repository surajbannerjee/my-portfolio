# ====================================================
# Email Settings for Contact Form (Nodemailer)
# ====================================================
# To send emails via Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Add to .env.local or Vercel Environment Variables:

# Preferred / Vercel naming:
MAIL_USERNAME=surajbanerjee255@gmail.com
MAIL_PASSWORD=your_16_character_app_password
RECIPIENT_EMAIL=surajbanerjee255@gmail.com

# Alternative aliases (also supported):
EMAIL_USER=surajbanerjee255@gmail.com
EMAIL_PASS=your_16_character_app_password

